# Copy to .env.local (never commit that file; .gitignore already excludes it)
# and fill every value in. The portal explains what is missing on screen rather
# than failing with a stack trace, but it cannot work without these.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Supabase Postgres connection string (Project Settings -> Database).
# Use the pooled "Transaction" or "Session" URI, not the direct one, on
# serverless hosts. Must include sslmode=require for a hosted database.
#
# Prefer the `portal_app` role over `postgres`. `postgres` owns every table and
# has BYPASSRLS, so no database policy applies to it and the app-layer checks
# are the only control. `portal_app` has no BYPASSRLS, no DELETE and no DDL.
# It ships without a password; see "Switching the portal onto it" in
# SECURITY.md. Until you set one, use the owner connection below.
#
#   portal_app (recommended, once its password is set):
#   postgresql://portal_app.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Supabase Auth (browser + server)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
# The publishable (anon) key. Safe to expose: it carries no privileges by itself.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only. Bypasses RLS and is used solely to invite staff and to set or
# reset their passwords. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute origin used in invitation and password-reset emails. In production
# this must be the public URL of the portal, e.g. https://portal.example.co.ke
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. Branch used for the sales terminal when a staff profile has no
# branch grant. Leave blank in production so the grant is the only source.
SALES_BRANCH_ID=""

# Vercel sets VERCEL_URL automatically; it is only a fallback for
# NEXT_PUBLIC_APP_URL and does not need to be set by hand.
